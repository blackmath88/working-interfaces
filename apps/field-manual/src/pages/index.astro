---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Working Interfaces">
  <p class="eyebrow">Field manual · architecture proof</p>
  <h1>Interfaces for accountable work.</h1>
  <p class="lead">
    A fast, knowledge-first environment for prototyping serious interfaces while preserving the speed and confidence of plain HTML.
  </p>

  <div class="grid">
    <section class="panel">
      <h2>Prototype lane</h2>
      <p>Open the existing visual studies unchanged, or add a new one-shot HTML experiment.</p>
      <a href="/experiments/">Browse experiments →</a>
    </section>
    <section class="panel">
      <h2>Knowledge loop</h2>
      <p>One Markdown record becomes a readable page, JSON resource, and raw download.</p>
      <a href="/knowledge/">Inspect the first record →</a>
    </section>
    <section class="panel">
      <h2>Legacy field manual</h2>
      <p>The complete original Case Systems manual remains intact as design evidence.</p>
      <a href="/legacy/">Open the manual →</a>
    </section>
  </div>
</BaseLayout>
