---
import BaseLayout from '../layouts/BaseLayout.astro';
import { manualPages, referencePages } from '../lib/legacy-pages';
const experiments = [
  ...manualPages.slice(0, 6).map((page) => ({ title: page.title, status: 'Astro route', href: `/manual/${page.slug}/` })),
  ...referencePages.map((page) => ({ title: page.title, status: 'Astro route', href: `/reference/${page.slug}/` })),
  { title: 'Legacy field manual index', status: 'Raw HTML lane', href: '/legacy/' },
];
---
<BaseLayout title="Experiments · Working Interfaces">
  <p class="eyebrow">Raw HTML prototype lane</p>
  <h1>Make it visible before making it durable.</h1>
  <p class="lead">These studies remain plain HTML, CSS, and JavaScript. They are evidence, not production architecture, and the original static lane is still available for direct comparison.</p>
  <div class="grid">
    {experiments.map((item) => (
      <article class="panel">
        <p class="eyebrow">{item.status}</p>
        <h2>{item.title}</h2>
        <a href={item.href}>Open prototype →</a>
      </article>
    ))}
  </div>
</BaseLayout>
