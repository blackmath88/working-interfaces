---
import { readFileSync } from 'node:fs';
import { referencePages } from '../../../../lib/legacy-pages';
import LegacyHtmlPage from '../../../../components/LegacyHtmlPage.astro';

const page = referencePages[0];
const source = readFileSync(new URL(`../../../../../public/legacy/${page.source}`, import.meta.url), 'utf8');
const headMatch = source.match(/<head[^>]*>([\s\S]*?)<\/head>/i);
const bodyMatch = source.match(/<body[^>]*>([\s\S]*?)<\/body>/i);
const titleMatch = source.match(/<title>([\s\S]*?)<\/title>/i);
const canonicalTitle = titleMatch?.[1] ?? page.title;
---
<LegacyHtmlPage
  title={canonicalTitle}
  headHtml={headMatch?.[1] ?? ''}
  bodyHtml={bodyMatch?.[1] ?? ''}
/>