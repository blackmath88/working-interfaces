{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "rough",
        "experiment",
        "promising",
        "reference",
        "graduated",
        "discarded"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "component",
        "pattern",
        "doctrine"
      ]
    },
    "revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "related": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "title",
    "status",
    "kind",
    "revision",
    "summary"
  ]
}