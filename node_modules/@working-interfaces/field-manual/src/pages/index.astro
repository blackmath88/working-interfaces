---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { manualPages, referencePages } from '../lib/legacy-pages';

const records = await getCollection('components');
const [referenceApp] = referencePages;

const figures = [
  { value: String(manualPages.length), label: 'manual chapters, each routed through Astro' },
  { value: String(referencePages.length), label: 'reference app kept as one working implementation' },
  { value: String(records.length), label: 'canonical record published as page, JSON, and Markdown' },
  { value: '2', label: 'lanes: raw HTML experiments and canonical knowledge' },
];
---
<BaseLayout
  title="Working Interfaces"
  description="Entry point to the Case Systems field manual, the raw HTML experiment lane, and the canonical knowledge records."
>
  <section class="masthead">
    <div class="masthead__lede">
      <div>
        <p class="eyebrow">Working Interfaces · field manual</p>
        <h1>Interfaces for accountable work.</h1>
        <p class="lead">
          A knowledge-first environment for designing applications where information moves through
          stages, evidence changes assumptions, and decisions stay inspectable. The manual behind
          this page is the evidence; this page is the way in.
        </p>
      </div>
      <div class="actions">
        <a class="button" href="/manual/">Open the manual</a>
        <a class="button button--secondary" href="/knowledge/">Inspect a record</a>
        <a class="button button--secondary" href="/experiments/">See the experiment register</a>
      </div>
    </div>
    <aside class="masthead__figures" aria-label="Scope of this site">
      {figures.map((figure) => (
        <div class="figure">
          <b class="numeric">{figure.value}</b>
          <span>{figure.label}</span>
        </div>
      ))}
    </aside>
  </section>

  <section class="section" aria-labelledby="lanes">
    <div class="section-head">
      <div>
        <p class="eyebrow">How work moves here</p>
        <h2 id="lanes">Two lanes, one destination.</h2>
      </div>
      <p>Nothing is formalized before it has earned it. Both lanes stay open and neither one blocks the other.</p>
    </div>
    <div class="planes planes--2">
      <article class="plane">
        <p class="eyebrow">Lane 01 · raw HTML</p>
        <h3>Experiments stay plain</h3>
        <p>
          Studies are written as plain HTML, CSS, and JavaScript. They are visual evidence, not
          production architecture, and an experiment may remain evidence forever.
        </p>
        <ul>
          <li>No build step, no component API, no test obligation.</li>
          <li>The original static manual still ships unchanged under <code>/legacy/</code>.</li>
          <li>Proven parts are migrated selectively; a mass rewrite is not planned.</li>
        </ul>
        <a class="arrow-link" href="/experiments/">Open the experiment register →</a>
      </article>
      <article class="plane">
        <p class="eyebrow">Lane 02 · canonical knowledge</p>
        <h3>Records are authored once</h3>
        <p>
          A record is one Markdown file with a validated frontmatter contract. It is published to
          people and machines from that single source.
        </p>
        <ul>
          <li>A readable page for review and discussion.</li>
          <li>A JSON resource for tools and agents.</li>
          <li>A raw Markdown download for grounding.</li>
        </ul>
        <a class="arrow-link" href="/knowledge/">Open the knowledge index →</a>
      </article>
    </div>
  </section>

  <section class="section" aria-labelledby="manual">
    <div class="section-head">
      <div>
        <p class="eyebrow">The manual</p>
        <h2 id="manual">From visual direction to a working case system.</h2>
      </div>
      <p>Each chapter is a standalone interactive document. Astro wraps the established HTML at build time, so the pages keep their original appearance and behavior.</p>
    </div>
    <ol class="register">
      {manualPages.map((page, index) => (
        <li>
          <a class="register__link" href={`/manual/${page.slug}/`}>
            <span class="register__index">{String(index + 1).padStart(2, '0')}</span>
            <span class="register__title">{page.title}</span>
            <span class="register__note">{page.summary}</span>
            <span class="register__go" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
      {referenceApp && (
        <li>
          <a class="register__link" href={`/reference/${referenceApp.slug}/`}>
            <span class="register__index">REF</span>
            <span class="register__title">{referenceApp.title}</span>
            <span class="register__note">{referenceApp.summary}</span>
            <span class="register__go" aria-hidden="true">→</span>
          </a>
        </li>
      )}
    </ol>
  </section>

  <section class="section" aria-labelledby="entries">
    <div class="section-head">
      <div>
        <p class="eyebrow">Other entrances</p>
        <h2 id="entries">The sources stay open.</h2>
      </div>
    </div>
    <div class="planes planes--2">
      <article class="plane">
        <p class="eyebrow">Raw lane</p>
        <h3>The static field manual</h3>
        <p>The original entry point, its chapters, and the reference app, served exactly as written and unaffected by the Astro shell.</p>
        <a class="arrow-link" href="/legacy/">Open /legacy/ →</a>
      </article>
      <article class="plane plane--sunken">
        <p class="eyebrow">Grounding</p>
        <h3>Sources of truth for agents</h3>
        <p>The design doctrine, the token vocabulary, and the system model that both lanes are held against.</p>
        <a class="arrow-link" href="/legacy/grounding/design-doctrine.md">Read the design doctrine →</a>
      </article>
    </div>
  </section>
</BaseLayout>
